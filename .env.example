# Polymarket Data Connectors Configuration
# Copy this file to .env and update values as needed

# =============================================================================
# BINANCE CONFIGURATION
# =============================================================================

# WebSocket base URL
BINANCE_WS_URL=wss://stream.binance.com:9443

# Symbols to subscribe to (comma-separated, lowercase)
# Example: btcusdt,ethusdt,solusdt,bnbusdt
BINANCE_SYMBOLS=btcusdt,ethusdt

# Connection settings
BINANCE_PING_INTERVAL_SEC=30.0
BINANCE_PING_TIMEOUT_SEC=10.0
BINANCE_RECONNECT_DELAY_BASE_SEC=1.0
BINANCE_RECONNECT_DELAY_MAX_SEC=60.0

# =============================================================================
# POLYMARKET GAMMA API CONFIGURATION
# =============================================================================

# Gamma API base URL
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com

# Market discovery interval (seconds)
POLYMARKET_DISCOVERY_INTERVAL_SEC=30.0

# =============================================================================
# POLYMARKET SERIES CONFIGURATION (Up/Down Markets)
# =============================================================================

# Series to subscribe to (comma-separated "COIN-DURATION" pairs)
# Available durations: 5M, 15M, DAILY
# 
# Examples:
#   BTC-15M           - Bitcoin 15-minute up/down markets
#   ETH-15M           - Ethereum 15-minute up/down markets  
#   BTC-15M,ETH-15M   - Both Bitcoin and Ethereum 15-minute markets
#   BTC-5M            - Bitcoin 5-minute up/down markets
#   BTC-DAILY         - Bitcoin daily up/down markets
#
# Known series IDs (for reference):
#   BTC-15M  -> series_id=10192, slug=btc-up-or-down-15m
#   ETH-15M  -> series_id=10191, slug=eth-up-or-down-15m
#   BTC-5M   -> series_id=10684, slug=btc-up-or-down-5m
#   BTC-DAILY-> series_id=41,    slug=btc-up-or-down-daily
POLYMARKET_SERIES=BTC-15M

# Maximum number of active events to track per series
# (events are 15-minute windows that rotate)
POLYMARKET_MAX_EVENTS_PER_SERIES=3

# Request settings
POLYMARKET_REQUEST_TIMEOUT_SEC=10.0
POLYMARKET_RECONNECT_DELAY_BASE_SEC=1.0
POLYMARKET_RECONNECT_DELAY_MAX_SEC=300.0

# =============================================================================
# POLYMARKET CLOB CONFIGURATION
# =============================================================================

# WebSocket URL for CLOB
POLYMARKET_CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com

# REST API URL for CLOB
POLYMARKET_CLOB_REST_URL=https://clob.polymarket.com

# API credentials (optional - needed for authenticated endpoints)
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=

# WebSocket ping interval
POLYMARKET_PING_INTERVAL_SEC=10.0

# REST polling interval (used in fallback mode)
POLYMARKET_REST_POLL_INTERVAL_SEC=5.0

# Threshold to consider WS unhealthy (triggers REST fallback)
POLYMARKET_WS_UNHEALTHY_THRESHOLD_SEC=30.0

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log directory path
LOG_PATH=./logs

# Log file name (JSONL format)
LOG_FILE_NAME=connectors.jsonl

# Log rotation settings
LOG_MAX_FILE_SIZE_MB=100
LOG_BACKUP_COUNT=5

# Console logging
LOG_CONSOLE_ENABLED=true
LOG_CONSOLE_LEVEL=INFO

# File logging level
LOG_FILE_LEVEL=DEBUG

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Status line print interval (seconds)
STATUS_INTERVAL_SEC=10.0

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL_SEC=5.0
